#!/usr/bin/perl
# Bounded, descriptor-backed local inventory for Capture Conveyor.
use strict;
use warnings;

use Cwd qw(realpath);
use Fcntl qw(O_DIRECTORY O_NOFOLLOW O_NONBLOCK O_RDONLY :mode);
use JSON::PP ();

my $MAX_ITEMS        = 24;
my $SCAN_BUDGET      = 512;
my $CONFIG_MAX_BYTES = 8192;
my $home             = $ENV{HOME} // '';
my $config_dir       = length($ENV{XDG_CONFIG_HOME} // '')
    ? $ENV{XDG_CONFIG_HOME}
    : "$home/.config";

sub emit_result {
    my ($directory, $truncated, $captures) = @_;
    print JSON::PP->new->ascii(1)->canonical(1)->encode({
        directory => $directory,
        truncated => $truncated ? JSON::PP::true : JSON::PP::false,
        captures  => $captures,
    }), "\n";
}

sub configured_pictures_suffix {
    my ($dir) = @_;

    # Pin the parent first. /proc/self/fd keeps the lookup rooted in that exact
    # directory even if a same-UID process swaps the pathname concurrently.
    sysopen(my $dir_fh, $dir,
        O_RDONLY | O_NONBLOCK | O_DIRECTORY | O_NOFOLLOW) or return '';
    my @dir_stat = stat($dir_fh);
    return '' unless @dir_stat && S_ISDIR($dir_stat[2]);

    my $pinned = '/proc/self/fd/' . fileno($dir_fh) . '/user-dirs.dirs';
    sysopen(my $config_fh, $pinned,
        O_RDONLY | O_NONBLOCK | O_NOFOLLOW) or return '';
    my @config_stat = stat($config_fh);
    return '' unless @config_stat
        && S_ISREG($config_stat[2])
        && $config_stat[4] == $<
        && $config_stat[7] <= $CONFIG_MAX_BYTES;

    my $contents = '';
    my $read = sysread($config_fh, $contents, $CONFIG_MAX_BYTES + 1);
    return '' unless defined($read) && $read <= $CONFIG_MAX_BYTES;

    for my $line (split /\n/, $contents) {
        # Match the XDG form without evaluating the file as shell code.
        return $1 if $line =~ /^XDG_PICTURES_DIR="\$HOME(\/[^"\x00-\x1f]*)"\r?$/;
    }
    return '';
}

my $configured = configured_pictures_suffix($config_dir);
my $directory = length($ENV{OMARCHY_SCREENSHOT_DIR} // '')
    ? $ENV{OMARCHY_SCREENSHOT_DIR}
    : length($ENV{XDG_PICTURES_DIR} // '')
        ? $ENV{XDG_PICTURES_DIR}
        : length($configured)
            ? "$home$configured"
            : "$home/Pictures";

my $resolved = realpath($directory);
unless (defined($resolved)) {
    emit_result($directory, 0, []);
    exit 0;
}

# Hold the directory while enumerating it, and open each candidate beneath the
# held descriptor. No image content is read and no replaceable records tempfile
# exists: the bounded result set stays in memory until the single JSON write.
opendir(my $dir_handle, $resolved) or do {
    emit_result($directory, 0, []);
    exit 0;
};
my @held_stat = stat($dir_handle);
unless (@held_stat && S_ISDIR($held_stat[2])) {
    emit_result($directory, 0, []);
    exit 0;
}

my $held_prefix = '/proc/self/fd/' . fileno($dir_handle);
my @captures;
my $budget_hit = 0;
while (defined(my $name = readdir($dir_handle))) {
    next unless $name =~ /^screenshot-.*\.png$/;

    sysopen(my $image_fh, "$held_prefix/$name",
        O_RDONLY | O_NONBLOCK | O_NOFOLLOW) or next;
    my @image_stat = stat($image_fh);
    next unless @image_stat && S_ISREG($image_stat[2]);

    push @captures, {
        path     => "$resolved/$name",
        modified => 0 + $image_stat[9],
        bytes    => 0 + $image_stat[7],
    };
    if (@captures >= $SCAN_BUDGET) {
        $budget_hit = 1;
        last;
    }
}

# If the configured directory pathname was replaced during the scan, discard
# the snapshot instead of returning paths that no longer name the held inode.
my @final_stat = stat($resolved);
unless (@final_stat
    && $final_stat[0] == $held_stat[0]
    && $final_stat[1] == $held_stat[1]) {
    emit_result($directory, 0, []);
    exit 0;
}

@captures = sort {
    $b->{modified} <=> $a->{modified} || $a->{path} cmp $b->{path}
} @captures;
my $truncated = $budget_hit || @captures > $MAX_ITEMS;
splice(@captures, $MAX_ITEMS) if @captures > $MAX_ITEMS;

emit_result($resolved, $truncated, \@captures);
